<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YUNAN Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --admin-dark: #1e293b;
            --admin-accent: #f1149b;
            --bg-body: #f1f5f9;
            --text-muted: #64748b;
        }

        html, body {
            height: 100%;
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-body);
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar-admin {
            background-color: var(--admin-dark);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            padding: 0.8rem 1rem;
        }

        .navbar-brand {
            font-weight: 700;
            color: white !important;
            letter-spacing: 0.5px;
        }

        .navbar-brand i {
            color: var(--admin-accent);
        }

        .nav-link-user {
            color: rgba(255,255,255,0.9) !important;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: color 0.3s;
        }

        .nav-link-user:hover {
            color: var(--admin-accent) !important;
        }

        .content-wrapper {
            flex: 1 0 auto;
            padding: 2rem 0;
        }

        footer {
            flex-shrink: 0;
            background-color: white;
            border-top: 1px solid #e2e8f0;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        .admin-card {
            background: white;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1);
            padding: 1.5rem;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-admin">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="PanelAdministrador">
                    <i class="bi bi-shield-lock-fill fs-4"></i>
                    <span>YUNAN <span class="fw-light opacity-75">ADMIN</span></span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (Context.Session.GetInt32("UsuarioId") != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle nav-link-user" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="rounded-circle bg-white text-dark d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    @Context.Session.GetString("NombreUsuario")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="navbarDropdown">
                                    <li><span class="dropdown-header text-uppercase" style="font-size: 0.75rem;">Sesión</span></li>
                                    <li>
                                        <a class="dropdown-item text-danger d-flex align-items-center gap-2" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="footer py-3 mt-auto">
        <div class="container text-center">
            <span class="fw-medium">&copy; 2025 YUNAN S.A.C.</span>
            <span class="mx-2">|</span>
            <span>Panel Administrativo</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>