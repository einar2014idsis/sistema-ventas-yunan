@model IEnumerable<Proyecto_DAS.ViewModels.CuponDescuento.CuponDescuentoViewModel>

@{
    ViewData["Title"] = "Cupones de Descuento";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-x-circle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">@ViewData["Title"]</h1>
            <hr />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12 d-flex justify-content-between">
            <a asp-controller="Home" asp-action="PanelAdministrador" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver al panel
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nuevo Cupón
            </a>
        </div>
    </div>
    
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.CodigoCupon)</th>
                            <th>@Html.DisplayNameFor(model => model.PorcentajeDescuento)</th>
                            <th>@Html.DisplayNameFor(model => model.FechaInicio)</th>
                            <th>@Html.DisplayNameFor(model => model.FechaVencimiento)</th>
                            <th>Estado</th>
                            <th>Días Restantes</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.CodigoCupon</strong></td>
                                    <td><span class="badge bg-success">@item.PorcentajeDescuento%</span></td>
                                    <td>@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                                    <td>@item.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (item.EstadoTexto == "Activo")
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Activo
                                            </span>
                                        }
                                        else if (item.EstadoTexto == "Vencido")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i> Vencido
                                            </span>
                                        }
                                        else if (item.EstadoTexto == "Programado")
                                        {
                                            <span class="badge bg-info">
                                                <i class="bi bi-clock"></i> Programado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-dash-circle"></i> Inactivo
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.DiasRestantes > 0)
                                        {
                                            <span class="text-muted">@item.DiasRestantes días</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Vencido</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.IdCuponDescuento" class="btn btn-sm btn-info" title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.IdCuponDescuento" class="btn btn-sm btn-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdCuponDescuento" class="btn btn-sm btn-danger"
                                           onclick="return confirm('¿Estas seguro de eliminar este Cupón de Descuento?')">
                                            <i class="bi bi-trash-fill"></i> Eliminar
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                                    <p class="mt-2 text-muted">No hay cupones registrados</p>
                                    <a asp-action="Create" class="btn btn-primary">
                                        <i class="bi bi-plus-circle"></i> Crear Primer Cupón
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>