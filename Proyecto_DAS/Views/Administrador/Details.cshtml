@model Proyecto_DAS.ViewModels.Administrador.AdministradorViewModel
@{
    ViewData["Title"] = "Perfil de Administrador";
    Layout = "_LayoutAdmin";
}

<style>
    .profile-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        background: white;
        overflow: hidden;
    }

    .profile-avatar-lg {
        width: 100px;
        height: 100px;
        background-color: #f1f5f9;
        color: #475569;
        font-size: 2.5rem;
        font-weight: 700;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        border: 4px solid white;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .profile-header-bg {
        height: 100px;
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }

    .detail-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #94a3b8;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .detail-value {
        font-size: 1rem;
        color: #334155;
        font-weight: 500;
    }

    .info-group {
        padding: 1rem;
        border-bottom: 1px solid #f8fafc;
        transition: background-color 0.2s;
    }

        .info-group:last-child {
            border-bottom: none;
        }

        .info-group:hover {
            background-color: #fcfcfc;
        }
</style>

<div class="container mt-4">

    <div class="mb-4">
        <a asp-action="Index" class="text-decoration-none text-muted fw-bold small">
            <i class="bi bi-arrow-left me-1"></i> Volver a la lista
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="profile-card h-100 pb-4">
                <div class="profile-header-bg"></div>
                <div class="px-4" style="margin-top: -50px;">
                    @{
                        var iniciales = $"{Model.Nombres?.Substring(0, 1)}{Model.Apellidos?.Substring(0, 1)}";
                    }
                    <div class="profile-avatar-lg">@iniciales</div>

                    <div class="text-center mt-3">
                        <h4 class="fw-bold text-dark mb-1">@Model.Nombres @Model.Apellidos</h4>
                        <div class="badge bg-light text-dark border px-3 py-2 mb-2">
                            @Model.Cargo
                        </div>

                        <div class="mt-2">
                            @if (Model.Estado)
                            {
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 6px; vertical-align: middle;"></i> Cuenta Activa
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 6px; vertical-align: middle;"></i> Cuenta Inactiva
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="profile-card h-100">
                <div class="p-4 border-bottom">
                    <h5 class="fw-bold m-0"><i class="bi bi-person-lines-fill me-2 text-muted"></i>Información Personal</h5>
                </div>

                <div class="card-body p-0">
                    <div class="row g-0">
                        <div class="col-md-6 info-group">
                            <div class="detail-label">Correo Electrónico</div>
                            <div class="detail-value d-flex align-items-center">
                                <i class="bi bi-envelope text-muted me-2"></i> @Model.Email
                            </div>
                        </div>

                        <div class="col-md-6 info-group">
                            <div class="detail-label">Celular de Contacto</div>
                            <div class="detail-value d-flex align-items-center">
                                <i class="bi bi-telephone text-muted me-2"></i>
                                @(!string.IsNullOrEmpty(Model.Celular) ? Model.Celular : "No registrado")
                            </div>
                        </div>

                        <div class="col-md-6 info-group">
                            <div class="detail-label">Fecha de Contratación</div>
                            <div class="detail-value d-flex align-items-center">
                                <i class="bi bi-calendar-check text-muted me-2"></i> @Model.FechaContratacion.ToString("dd MMMM, yyyy")
                            </div>
                        </div>

                        <div class="col-md-6 info-group">
                            <div class="detail-label">Antigüedad</div>
                            <div class="detail-value">
                                @{
                                    var antiguedad = DateTime.Now.Year - Model.FechaContratacion.Year;
                                    var textoAntiguedad = antiguedad == 0 ? "Menos de un año" : $"{antiguedad} año(s)";
                                }
                                <span class="text-muted">@textoAntiguedad</span>
                            </div>
                        </div>

                        <div class="col-12 bg-light p-3 border-top mt-2">
                            <div class="d-flex align-items-center text-muted small">
                                <i class="bi bi-database-lock me-2"></i>
                                <span>ID de Sistema: <span class="font-monospace user-select-all">@Model.IdAdministrador</span></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>