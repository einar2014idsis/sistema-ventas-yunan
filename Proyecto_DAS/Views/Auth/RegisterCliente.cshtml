@model Proyecto_DAS.ViewModels.Auth.RegisterClienteViewModel
@{
    ViewData["Title"] = "Registro de Cliente";
    Layout = "_LayoutCliente";
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-controller="ClientePanel" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Catálogo
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0">
                <div class="card-header text-white text-center" style="background-color: #f1149b;">
                    <h4 class="mb-0">
                        <i class="bi bi-person-plus-fill"></i> Registro de Cliente
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="RegisterCliente" method="post" autocomplete="off">
                        <h6 class="text-muted mb-3"><i class="bi bi-person me-1"></i> Datos personales</h6>

                        <div class="mb-3">
                            <label asp-for="Nombres" class="form-label"></label>
                            <input asp-for="Nombres" class="form-control" id="Nombres" />
                            <span asp-validation-for="Nombres" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Apellidos" class="form-label"></label>
                            <input asp-for="Apellidos" class="form-control" id="Apellidos" />
                            <span asp-validation-for="Apellidos" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" class="form-control" />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Contrasenia" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Contrasenia" type="password" class="form-control" id="Contrasenia" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('Contrasenia', 'iconContrasenia')">
                                    <i class="bi bi-eye" id="iconContrasenia"></i>
                                </button>
                            </div>
                            @if (!ViewData.ModelState.ContainsKey("Contrasenia") || ViewData.ModelState["Contrasenia"].Errors.Count == 0)
                            {
                                <div id="contrasenaFeedback" style="display: none;"></div>
                            }
                            <span asp-validation-for="Contrasenia" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmarContrasenia" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="ConfirmarContrasenia" type="password" class="form-control" id="ConfirmarContrasenia" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('ConfirmarContrasenia', 'iconConfirmar')">
                                    <i class="bi bi-eye" id="iconConfirmar"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmarContrasenia" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Celular" class="form-label"></label>
                            <input asp-for="Celular" class="form-control" id="Celular" maxlength="9" pattern="9[0-9]{8}" />
                            <small class="text-muted">Debe empezar con 9 y tener 9 dígitos</small>
                            <span asp-validation-for="Celular" class="text-danger"></span>
                        </div>

                        <hr class="my-3" />
                        <h6 class="text-muted mb-3"><i class="bi bi-geo-alt me-1"></i> Datos de envío</h6>

                        <div class="mb-3">
                            <label asp-for="Direccion" class="form-label"></label>
                            <input asp-for="Direccion" class="form-control" id="Direccion" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Ciudad" class="form-label"></label>
                                <input asp-for="Ciudad" class="form-control" id="Ciudad" />
                                <span asp-validation-for="Ciudad" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CodigoPostal" class="form-label"></label>
                                <input asp-for="CodigoPostal" class="form-control" id="CodigoPostal" maxlength="6" />
                                <span asp-validation-for="CodigoPostal" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DniRuc" class="form-label"></label>
                                <input asp-for="DniRuc" class="form-control" id="DniRuc" maxlength="11" />
                                <span asp-validation-for="DniRuc" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="FechaNacimiento" class="form-label"></label>
                                <input asp-for="FechaNacimiento" class="form-control" type="date" max="@DateTime.Now.AddYears(-18).ToString("yyyy-MM-dd")" min="@DateTime.Now.AddYears(-120).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn w-100 text-white" style="background-color: #f1149b;">
                            <i class="bi bi-check-lg me-1"></i> Registrarse
                        </button>
                    </form>

                    <div class="mt-3 text-center">
                        <span class="text-muted">¿Ya tienes cuenta?</span>
                        <a asp-action="Login" style="color: #f1149b; text-decoration: none; font-weight: 500;">
                            Inicia sesión
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/validaciones.js"></script>
    <script>
        function togglePassword(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            ValidacionesYUNAN.validarContrasenaEnTiempoReal('Contrasenia', 'contrasenaFeedback');

            ValidacionesYUNAN.validarPorId('Nombres', 'soloLetras');
            ValidacionesYUNAN.validarPorId('Apellidos', 'soloLetras');
            ValidacionesYUNAN.validarPorId('Celular', 'soloNumeros');
            ValidacionesYUNAN.validarPorId('Direccion', 'direccion');
            ValidacionesYUNAN.validarPorId('Ciudad', 'soloLetras');
            ValidacionesYUNAN.validarPorId('CodigoPostal', 'soloNumeros');
            ValidacionesYUNAN.validarPorId('DniRuc', 'soloNumeros');
        });
    </script>
}
