@model Proyecto_DAS.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutCliente";
}

<div class="container mt-4">
    <div class="mb-3">
        <a asp-controller="ClientePanel" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Catálogo
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-header text-white text-center" style="background-color: #f1149b;">
                    <h4 class="mb-0">
                        <i class="bi bi-person-circle"></i> Iniciar Sesión
                    </h4>
                </div>
                <div class="card-body">

                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-success">@ViewBag.Mensaje</div>
                    }

                    <form asp-action="Login" method="post" autocomplete="off">
                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" class="form-control" />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Contrasenia" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Contrasenia" type="password" class="form-control" id="Contrasenia" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword()">
                                    <i class="bi bi-eye" id="iconContrasenia"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Contrasenia" class="text-danger"></span>
                        </div>

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <button type="submit" class="btn w-100 text-white" style="background-color: #f1149b;">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar
                        </button>
                    </form>

                    <div class="mt-3 text-center">
                        <span class="text-muted">¿No tienes cuenta?</span>
                        <a asp-action="RegisterCliente" style="color: #f1149b; text-decoration: none; font-weight: 500;">
                            Regístrate aquí
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function togglePassword() {
            var input = document.getElementById('Contrasenia');
            var icon = document.getElementById('iconContrasenia');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
