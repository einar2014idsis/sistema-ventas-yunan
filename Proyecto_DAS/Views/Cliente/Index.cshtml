@model List<Proyecto_DAS.ViewModels.Cliente.ClienteViewModel>
@{
    ViewData["Title"] = "Clientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-controller="Home" asp-action="PanelAdministrador" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al Panel
        </a>
        <h2 class="mb-0"><i class="bi bi-people me-2"></i>Gestión de Clientes</h2>
        <a asp-action="Create" class="btn text-white" style="background-color: #f1149b;">
            <i class="bi bi-plus-lg"></i> Nuevo Cliente
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-person-x" style="font-size: 3rem; color: #6c757d;"></i>
                    <p class="mt-3 text-muted">No hay clientes registrados</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre Completo</th>
                                <th>Email</th>
                                <th>Celular</th>
                                <th>DNI/RUC</th>
                                <th>Ciudad</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cliente in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@cliente.Apellidos</strong>, @cliente.Nombres
                                    </td>
                                    <td>@cliente.Email</td>
                                    <td>@cliente.Celular</td>
                                    <td>@cliente.DniRuc</td>
                                    <td>@cliente.Ciudad</td>
                                    <td>
                                        @if (cliente.Estado)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-info" title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@cliente.IdCliente" class="btn btn-sm btn-danger"
                                           onclick="return confirm('¿Estas seguro de eliminar este cliente?')">
                                            <i class="bi bi-trash-fill"></i> Eliminar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>