@model Proyecto_DAS.ViewModels.Cliente.ClienteViewModel
@{
    ViewData["Title"] = "Detalles del Cliente";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header" style="background-color: #f8cde7;">
                    <h4 class="mb-0"><i class="bi bi-person-badge me-2"></i>Detalles del Cliente</h4>
                </div>
                <div class="card-body">
                    <h5 class="mb-3 text-muted"><i class="bi bi-person me-2"></i>Datos Personales</h5>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted">Nombres</h6>
                            <p class="fs-5">@Model.Nombres</p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Apellidos</h6>
                            <p class="fs-5">@Model.Apellidos</p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted">Correo Electrónico</h6>
                            <p class="fs-5">
                                <i class="bi bi-envelope me-2"></i>@Model.Email
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Celular</h6>
                            <p class="fs-5">
                                <i class="bi bi-telephone me-2"></i>@Model.Celular
                            </p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted">DNI/RUC</h6>
                            <p class="fs-5">
                                <i class="bi bi-card-text me-2"></i>@Model.DniRuc
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Fecha de Nacimiento</h6>
                            <p class="fs-5">
                                <i class="bi bi-calendar me-2"></i>@Model.FechaNacimiento.ToString("dd/MM/yyyy")
                            </p>
                        </div>
                    </div>

                    <hr />

                    <h5 class="mb-3 text-muted"><i class="bi bi-geo-alt me-2"></i>Datos de Ubicación</h5>

                    <div class="row mb-4">
                        <div class="col-md-12">
                            <h6 class="text-muted">Dirección</h6>
                            <p class="fs-5">
                                <i class="bi bi-house me-2"></i>@Model.Direccion
                            </p>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted">Ciudad</h6>
                            <p class="fs-5">
                                <i class="bi bi-building me-2"></i>@Model.Ciudad
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted">Código Postal</h6>
                            <p class="fs-5">
                                <i class="bi bi-mailbox me-2"></i>@Model.CodigoPostal
                            </p>
                        </div>
                    </div>

                    <hr />

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-muted">Estado</h6>
                            @if (Model.Estado)
                            {
                                <span class="badge bg-success fs-6">
                                    <i class="bi bi-check-circle me-1"></i>Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">
                                    <i class="bi bi-x-circle me-1"></i>Inactivo
                                </span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Volver
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
