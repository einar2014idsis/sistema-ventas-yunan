@model Proyecto_DAS.ViewModels.ClientePanel.EnvioDetalleViewModel
@{
    ViewData["Title"] = "Rastreo de Envío";
    Layout = "_LayoutCliente";
}

<style>
    :root {
        --track-color: #f1149b;
        --track-inactive: #e9ecef;
    }

    .tracking-card {
        background: white;
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .tracking-header {
        background: linear-gradient(135deg, #2c3e50 0%, #000000 100%);
        color: white;
        padding: 2rem;
        position: relative;
    }

    .btn-copy {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: white;
        border-radius: 8px;
        padding: 5px 10px;
        font-size: 0.8rem;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-copy:hover {
            background: rgba(255,255,255,0.25);
        }

    .timeline-wrapper {
        padding: 2rem;
    }

    .track-step {
        position: relative;
        padding-left: 3rem;
        padding-bottom: 2.5rem;
    }

        .track-step:last-child {
            padding-bottom: 0;
        }

        .track-step::before {
            content: '';
            position: absolute;
            left: 19px;
            top: 35px;
            bottom: 0;
            width: 2px;
            background-color: var(--track-inactive);
        }

        .track-step:last-child::before {
            display: none;
        }

        .track-step.completed::before {
            background-color: var(--track-color);
        }

    .step-icon {
        position: absolute;
        left: 0;
        top: 0;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: white;
        border: 2px solid var(--track-inactive);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
        z-index: 2;
        transition: all 0.3s ease;
    }

    .track-step.completed .step-icon {
        background-color: var(--track-color);
        border-color: var(--track-color);
        color: white;
    }

    .track-step.active .step-icon {
        border-color: var(--track-color);
        color: var(--track-color);
        background-color: white;
        box-shadow: 0 0 0 5px rgba(241, 20, 155, 0.15);
    }

        .track-step.active .step-icon::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            animation: pulse-ring 2s infinite;
            border: 2px solid var(--track-color);
        }

    @@keyframes pulse-ring {
        0%

    {
        transform: scale(0.8);
        opacity: 0.5;
    }

    100% {
        transform: scale(1.5);
        opacity: 0;
    }

    }

    .step-title {
        font-weight: 700;
        font-size: 1rem;
        color: #343a40;
        margin-bottom: 0.2rem;
    }

    .track-step.completed .step-title,
    .track-step.active .step-title {
        color: #000;
    }

    .step-desc {
        font-size: 0.85rem;
        color: #6c757d;
    }

    .info-box {
        background-color: #f8f9fa;
        border-radius: 12px;
        padding: 1.5rem;
        height: 100%;
    }

    .info-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #888;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .info-value {
        font-weight: 500;
        color: #333;
        margin-bottom: 1.5rem;
    }
</style>

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-10">

            <a asp-controller="ClientePanel" asp-action="MisCompras" class="text-decoration-none text-muted mb-3 d-inline-block small">
                <i class="bi bi-arrow-left me-1"></i> Volver a mis compras
            </a>

            <div class="tracking-card">

                <div class="tracking-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h6 class="text-white-50 text-uppercase mb-1" style="font-size: 0.75rem; letter-spacing: 1.5px;">Código de Seguimiento</h6>
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="mb-0 fw-bold" id="trackingCode">@Model.NumeroSeguimiento</h2>
                            <button class="btn-copy" onclick="copyToClipboard()" title="Copiar código">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="badge bg-white text-dark rounded-pill px-3 py-2 fw-bold text-uppercase">
                            <i class="bi bi-truck me-1 text-danger"></i> @Model.EmpresaTransporte
                        </div>
                    </div>
                </div>

                <div class="row g-0">
                    <div class="col-md-7 border-end">
                        <div class="timeline-wrapper">
                            <h5 class="fw-bold mb-4" style="font-family: 'Playfair Display', serif;">Progreso del Envío</h5>

                            @{
                                var estados = new[] { "pendiente", "en_proceso", "alistado", "enviado", "entregado" };
                                var estadoActualIndex = Array.IndexOf(estados, Model.EstadoEnvio.ToLower());
                                if (Model.EstadoEnvio.ToLower() == "cancelado") estadoActualIndex = -1;
                            }

                            @if (Model.EstadoEnvio.ToLower() == "cancelado")
                            {
                                <div class="alert alert-danger d-flex align-items-center p-4 rounded-3">
                                    <i class="bi bi-x-octagon-fill fs-1 me-3"></i>
                                    <div>
                                        <h5 class="alert-heading fw-bold mb-1">Envío Cancelado</h5>
                                        <p class="mb-0 small">Este envío ha sido detenido. Por favor contacta a soporte para más detalles.</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                @for (int i = 0; i < estados.Length; i++)
                                {
                                    var estado = estados[i];
                                    var isCompleted = i < estadoActualIndex;
                                    var isActive = i == estadoActualIndex;

                                    var stepClass = "";
                                    if (isCompleted) stepClass = "completed";
                                    if (isActive) stepClass = "active";

                                    var info = ObtenerInfoEstado(estado);

                                    <div class="track-step @stepClass">
                                        <div class="step-icon">
                                            @if (isCompleted)
                                            {
                                                <i class="bi bi-check-lg"></i>
                                            }
                                            else
                                            {

                                                <i class="bi @info.Icono"></i>
                                            }
                                        </div>
                                        <div class="step-content">
                                            <div class="step-title">@info.Titulo</div>
                                            <div class="step-desc">@info.Descripcion</div>

                                            @if (isActive && estado == "enviado")
                                            {
                                                <div class="mt-2 badge bg-light text-dark border">
                                                    <i class="bi bi-calendar-event me-1"></i> Llega el: @Model.FechaEntregaEstimada.ToString("dd/MM/yyyy")
                                                </div>
                                            }
                                            @if (isCompleted && estado == "entregado" && Model.FechaEntregaReal.HasValue)
                                            {
                                                <div class="mt-1 small text-success fw-bold">
                                                    Entregado el: @Model.FechaEntregaReal.Value.ToString("dd MMM yyyy, HH:mm")
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="info-box border-start-0 h-100 rounded-0">
                            <h5 class="fw-bold mb-4" style="font-family: 'Playfair Display', serif;">Detalles de Entrega</h5>

                            <div class="info-label">Dirección de Envío</div>
                            <div class="info-value">
                                <i class="bi bi-geo-alt-fill text-danger me-2"></i>@Model.DireccionEnvio
                                <div class="ps-4 text-muted small">@Model.Ciudad, CP: @Model.CodigoPostal</div>
                            </div>

                            <hr class="text-muted opacity-25 my-4">

                            <div class="info-label">Fechas Clave</div>

                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-white p-2 rounded border me-3 text-center">
                                    <small class="d-block text-muted text-uppercase" style="font-size: 0.6rem;">Enviado</small>
                                    <strong class="d-block">@Model.FechaEnvio.Day</strong>
                                </div>
                                <div>
                                    <div class="fw-bold">Fecha de Salida</div>
                                    <small class="text-muted">@Model.FechaEnvio.ToString("MMMM yyyy")</small>
                                </div>
                            </div>

                            @if (Model.EstadoEnvio.ToLower() == "entregado" && Model.FechaEntregaReal.HasValue)
                            {
                                <div class="d-flex align-items-center">
                                    <div class="bg-white p-2 rounded border me-3 text-center" style="border-color: #28a745 !important;">
                                        <small class="d-block text-success text-uppercase" style="font-size: 0.6rem;">Entregado</small>
                                        <strong class="d-block text-success">@Model.FechaEntregaReal.Value.Day</strong>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-success"><i class="bi bi-check-circle-fill me-1"></i>Fecha de Entrega</div>
                                        <small class="text-muted">@Model.FechaEntregaReal.Value.ToString("MMMM yyyy")</small>
                                    </div>
                                </div>
                            }
                            else if (Model.EstadoEnvio.ToLower() == "cancelado")
                            {
                                <div class="d-flex align-items-center">
                                    <div class="bg-white p-2 rounded border me-3 text-center" style="border-color: #dc3545 !important;">
                                        <i class="bi bi-x-lg text-danger fs-4"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-danger"><i class="bi bi-x-circle-fill me-1"></i>Pedido Cancelado</div>
                                        <small class="text-muted">Este envío fue cancelado</small>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center">
                                    <div class="bg-white p-2 rounded border me-3 text-center" style="width: 50px;">
                                        <small class="d-block text-muted text-uppercase" style="font-size: 0.6rem;">Est.</small>
                                        <strong class="d-block" style="color: #f1149b;">@Model.FechaEntregaEstimada.Day</strong>
                                    </div>
                                    <div>
                                        <div class="fw-bold">Entrega Estimada</div>
                                        <small class="text-muted">@Model.FechaEntregaEstimada.ToString("MMMM yyyy")</small>
                                    </div>
                                </div>
                            }

                            <div class="mt-5 text-center">
                                <a asp-controller="ClientePanel" asp-action="Index" class="btn btn-outline-dark w-100 rounded-pill">
                                    <i class="bi bi-shop me-2"></i> Seguir Comprando
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@functions {
    public (string Titulo, string Descripcion, string Icono) ObtenerInfoEstado(string estado)
    {
        return estado switch
        {
            "pendiente" => ("Orden Recibida", "Hemos recibido tu pedido y estamos verificando el pago.", "bi-file-earmark-text"),
            "en_proceso" => ("En Preparación", "Estamos seleccionando y empacando tus prendas con cuidado.", "bi-box-seam"),
            "alistado" => ("Listo para envío", "Tu paquete está etiquetado y esperando al transportista.", "bi-tags"),
            "enviado" => ("En Camino", "El paquete ha salido de nuestro almacén hacia tu dirección.", "bi-truck"),
            "entregado" => ("Entregado", "El paquete ha llegado a su destino. ¡Disfrútalo!", "bi-house-heart"),
            _ => (estado, "", "bi-circle")
        };
    }
}

@section Scripts {
    <script>
        function copyToClipboard() {
            const code = document.getElementById('trackingCode').innerText;
            navigator.clipboard.writeText(code).then(() => {
                const btn = document.querySelector('.btn-copy');
                const icon = btn.querySelector('i');
                const originalClass = icon.className;

                icon.className = 'bi bi-check-lg';
                btn.style.borderColor = '#2ecc71';
                btn.style.color = '#2ecc71';

                setTimeout(() => {
                    icon.className = originalClass;
                    btn.style.borderColor = '';
                    btn.style.color = '';
                }, 2000);
            });
        }
    </script>
}