@model Proyecto_DAS.ViewModels.Categoria.CategoriaEditViewModel

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">@ViewData["Title"]</h1>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-body">
                    <form asp-action="Edit" method="post" autocomplete="off">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="IdCategoria" />

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label"></label>
                            <input asp-for="Nombre" class="form-control" id="Nombre" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                            <div id="nombreFeedback"></div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descripcion" class="form-label"></label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4" id="Descripcion"></textarea>
                            <div id="descripcionFeedback" style="display: none;"></div>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input asp-for="Estado" class="form-check-input" type="checkbox" />
                                <label asp-for="Estado" class="form-check-label">Categoría Activa</label>
                            </div>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">
                                <i class="bi bi-x-circle-fill"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-circle-fill"></i> Actualizar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/validaciones.js"></script>
    <script>
        ValidacionesYUNAN.validarPorId('Nombre', 'letrasNumerosEspacios');
        ValidacionesYUNAN.validarContieneLetras('Nombre', 'nombreFeedback', 'El nombre debe contener al menos una letra');
        ValidacionesYUNAN.validarPorId('Descripcion', 'descripcion');
        ValidacionesYUNAN.validarDescripcionConLetras('Descripcion', 'descripcionFeedback');
    </script>
}
