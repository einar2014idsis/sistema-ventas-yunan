@model IEnumerable<Proyecto_DAS.ViewModels.Envio.EnvioViewModel>
@{
    ViewData["Title"] = "Gestión de Envíos";

    string FormatearEstado(string estado) => estado switch
    {
        "en_proceso" => "En proceso",
        "pendiente" => "Pendiente",
        "alistado" => "Alistado",
        "enviado" => "Enviado",
        "entregado" => "Entregado",
        "cancelado" => "Cancelado",
        _ => estado
    };
}

@section Styles {
    <style>
        .estado-actual {
            background-color: #fff3cd;
            font-weight: bold;
        }
        .estado-completado {
            background-color: #d1e7dd;
        }
        .estado-bloqueado {
            background-color: #f8f9fa;
            color: #6c757d;
        }
    </style>
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="display-4">@ViewData["Title"]</h1>
            <hr />
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Éxito!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-3">
        <div class="col-md-12">
            <a asp-controller="Home" asp-action="PanelAdministrador" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver al Panel
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Venta</th>
                                    <th>Cliente</th>
                                    <th>Dirección</th>
                                    <th>Ciudad</th>
                                    <th>Estado Actual</th>
                                    <th>Empresa</th>
                                    <th>Seguimiento</th>
                                    <th>Fecha Envío</th>
                                    <th class="text-center" style="min-width: 200px;">Gestión de Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="9" class="text-center text-muted">
                                            <p class="mt-3 mb-3">No hay envíos registrados.</p>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var e in Model)
                                    {
                                        var badgeClass = e.EstadoEnvio switch
                                        {
                                            "entregado" => "bg-success",
                                            "enviado" => "bg-info text-dark",
                                            "alistado" => "bg-warning text-dark",
                                            "en_proceso" => "bg-primary",
                                            "pendiente" => "bg-secondary",
                                            "cancelado" => "bg-danger",
                                            _ => "bg-secondary"
                                        };

                                        var siguienteEstado = e.EstadoEnvio switch
                                        {
                                            "pendiente" => "en_proceso",
                                            "en_proceso" => "alistado",
                                            "alistado" => "enviado",
                                            "enviado" => "entregado",
                                            _ => e.EstadoEnvio
                                        };

                                        var estadoFinal = e.EstadoEnvio == "entregado" || e.EstadoEnvio == "cancelado";

                                        <tr>
                                            <td><strong>#@e.VentaId</strong></td>
                                            <td>@e.ClienteNombre</td>
                                            <td>@e.DireccionEnvio</td>
                                            <td>@e.Ciudad</td>
                                            <td><span class="badge @badgeClass">@FormatearEstado(e.EstadoEnvio)</span></td>
                                            <td>@e.EmpresaTransporte</td>
                                            <td><code>@e.NumeroSeguimiento</code></td>
                                            <td>@e.FechaEnvio.ToString("dd/MM/yyyy")</td>

                                            <td class="text-center">
                                                @if (!estadoFinal)
                                                {
                                                    <form method="post" asp-action="ActualizarEstado" class="d-flex gap-2 justify-content-center" autocomplete="off">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="idEnvio" value="@e.IdEnvio" />

                                                        <div class="input-group input-group-sm">
                                                            <select name="nuevoEstado" class="form-select" style="max-width: 150px;">
                                                                <option value="@e.EstadoEnvio" selected class="estado-actual">@FormatearEstado(e.EstadoEnvio) (actual)</option>
                                                                <option value="@siguienteEstado" class="estado-siguiente">Ir a: @FormatearEstado(siguienteEstado)</option>

                                                                @if (e.EstadoEnvio != "pendiente")
                                                                {
                                                                    <option value="cancelado" class="text-danger">Cancelar</option>
                                                                }
                                                            </select>
                                                            <button type="submit" class="btn btn-warning" title="Guardar cambios">
                                                                <i class="bi bi-arrow-repeat"></i>
                                                            </button>
                                                        </div>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-outline-secondary btn-sm w-100" disabled>
                                                        <i class="bi bi-check-circle"></i> Finalizado
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>