@model List<Proyecto_DAS.ViewModels.Venta.VentaViewModel>
@{
    ViewData["Title"] = "Dashboard de ventas";
    var total = Model?.Sum(x => x.TotalVenta) ?? 0;
    var pedidos = Model?.Count ?? 0;
    var clientes = Model?.Select(x => x.ClienteId).Distinct().Count() ?? 0;
    var unidades = Model?.Sum(x => x.CantidadProductos) ?? 0;
    var ventasCompletas = ViewBag.VentasCompletas as List<Proyecto_DAS.Models.Venta> ?? new();
    var productos = ventasCompletas.SelectMany(v => v.DetallesVenta).GroupBy(d => d.Producto?.Nombre ?? "Producto").Select(g => new { Nombre = g.Key, Cantidad = g.Sum(d => d.Cantidad) }).OrderByDescending(x => x.Cantidad).Take(5).ToList();
    var pagos = ventasCompletas.GroupBy(v => v.MetodoPago).Select(g => new { Nombre = g.Key, Cantidad = g.Count() }).OrderByDescending(x => x.Cantidad).ToList();
    var series = ventasCompletas.GroupBy(v => v.FechaVenta.Date).OrderBy(g => g.Key).Select(g => new { Fecha = g.Key.ToString("yyyy-MM-dd"), Total = g.Sum(v => v.TotalVenta), Pedidos = g.Count() }).ToList();
    var categorias = ventasCompletas.SelectMany(v => v.DetallesVenta).GroupBy(d => d.Producto?.Categoria?.Nombre ?? "Sin categoría").Select(g => new { Nombre = g.Key, Cantidad = g.Sum(d => d.Cantidad) }).OrderByDescending(x => x.Cantidad).ToList();
}

@section Styles {
<style>
    .content-wrapper { background:#faf7fa; }
    .ventas-dashboard { color:#28344a; }
    .ventas-dashboard h1 { font-size:2rem; font-weight:750; letter-spacing:-.04em; }
    .ventas-dashboard .card, .dashboard-panel, .dashboard-stat { border:0; border-radius:16px; background:#fff; box-shadow:0 8px 30px rgba(91,45,76,.06); }
    .ventas-dashboard .card-header { border:0; border-radius:16px 16px 0 0 !important; }
    .dashboard-intro { color:#8992a3; margin-top:-10px; }
    .dashboard-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; margin:24px 0; }
    .dashboard-stat { padding:20px; }
    .dashboard-icon { width:42px; height:42px; display:grid; place-items:center; border-radius:13px; background:#fff0f7; color:#f1149b; font-size:1.2rem; margin-bottom:16px; }
    .dashboard-label { color:#8992a3; font-size:.8rem; }
    .dashboard-number { font-size:1.55rem; font-weight:750; margin:4px 0; }
    .dashboard-panels { display:grid; grid-template-columns:1.3fr 1fr; gap:16px; margin-bottom:24px; }
    .dashboard-panel { padding:22px; min-width:0; }
    .chart-grid { display:grid; grid-template-columns:2fr 1fr; gap:16px; margin-bottom:16px; }
    .chart-grid.secondary { grid-template-columns:1fr 1fr; }
    .chart-wrap { position:relative; height:260px; }
    .chart-title { display:flex; justify-content:space-between; gap:10px; align-items:center; }
    .chart-title select { width:auto; font-size:.8rem; }
    .chart-empty { display:flex; height:220px; align-items:center; justify-content:center; color:#8992a3; font-size:.85rem; }
    .dashboard-panel h2 { font-size:1rem; font-weight:700; margin-bottom:20px; }
    .dashboard-panel h2 i { color:#f1149b; margin-right:8px; }
    .dashboard-row { display:flex; align-items:center; gap:12px; margin:14px 0; font-size:.85rem; }
    .dashboard-rank { background:#fff0f7; color:#f1149b; border-radius:8px; width:28px; height:28px; display:grid; place-items:center; font-weight:700; flex-shrink:0; }
    .dashboard-row-name { flex:1; }
    .dashboard-bar { height:8px; border-radius:99px; background:#f8eaf2; overflow:hidden; }
    .dashboard-bar span { display:block; height:100%; border-radius:99px; background:linear-gradient(90deg,#ff91c9,#f1149b); }
    .ventas-dashboard .btn-primary { background:#f1149b; border-color:#f1149b; }
    .ventas-dashboard .btn-primary:hover { background:#d90987; border-color:#d90987; }
    .ventas-dashboard .table { vertical-align:middle; font-size:.85rem; }
    .ventas-dashboard .table th { color:#8a92a2; font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; }
    @@media(max-width:767px) { .dashboard-kpis { grid-template-columns:repeat(2,1fr); } .dashboard-panels, .chart-grid, .chart-grid.secondary { grid-template-columns:1fr; } }
    @@media(max-width:400px) { .dashboard-kpis { grid-template-columns:1fr; } }
</style>
}
<div class="ventas-dashboard mt-2">
    <div>
        <div class="row mb-4">
            <div class="col-md-12">
                <h1 class="display-4">@ViewData["Title"]</h1>
                <p class="dashboard-intro">Un vistazo al rendimiento de tu tienda. Las métricas reflejan los filtros seleccionados.</p>
            </div>
        </div>

        @await Html.PartialAsync("_DashboardAnalitico")
        <div class="dashboard-legacy" hidden>
        <div class="dashboard-kpis">
            <div class="dashboard-stat"><div class="dashboard-icon"><i class="bi bi-currency-dollar"></i></div><div class="dashboard-label">Ventas totales</div><div class="dashboard-number">S/ @total.ToString("N2")</div><small class="dashboard-label">Importe de ventas</small></div>
            <div class="dashboard-stat"><div class="dashboard-icon"><i class="bi bi-bag-heart"></i></div><div class="dashboard-label">Pedidos</div><div class="dashboard-number">@pedidos</div><small class="dashboard-label">Ventas registradas</small></div>
            <div class="dashboard-stat"><div class="dashboard-icon"><i class="bi bi-people"></i></div><div class="dashboard-label">Clientes</div><div class="dashboard-number">@clientes</div><small class="dashboard-label">Clientes con compras</small></div>
            <div class="dashboard-stat"><div class="dashboard-icon"><i class="bi bi-tags"></i></div><div class="dashboard-label">Productos vendidos</div><div class="dashboard-number">@unidades</div><small class="dashboard-label">Unidades vendidas</small></div>
        </div>
        <div class="chart-grid">
            <section class="dashboard-panel"><div class="chart-title"><h2><i class="bi bi-graph-up-arrow"></i>Evolución de ventas</h2><select id="periodoGrafico" class="form-select" aria-label="Periodo del gráfico"><option value="7">Últimos 7 días</option><option value="30">Últimos 30 días</option><option value="all">Todas las fechas</option></select></div><div class="chart-wrap"><canvas id="graficoVentas" aria-label="Evolución de ventas" role="img"></canvas></div></section>
            <section class="dashboard-panel"><h2><i class="bi bi-pie-chart"></i>Ventas por categoría</h2><div class="chart-wrap"><canvas id="graficoCategorias" aria-label="Productos vendidos por categoría" role="img"></canvas></div></section>
        </div>
        <div class="chart-grid secondary">
            <section class="dashboard-panel"><h2><i class="bi bi-bar-chart"></i>Productos más vendidos</h2><div class="chart-wrap"><canvas id="graficoProductos" aria-label="Productos más vendidos" role="img"></canvas></div></section>
            <section class="dashboard-panel"><h2><i class="bi bi-credit-card"></i>Pedidos por método de pago</h2><div class="chart-wrap"><canvas id="graficoPagos" aria-label="Pedidos por método de pago" role="img"></canvas></div></section>
        </div>
        @* Los gráficos anteriores utilizan los mismos resultados que la tabla. *@
        @if (false) { <div class="dashboard-panels">
            <div class="dashboard-panel"><h2><i class="bi bi-graph-up-arrow"></i>Productos más vendidos</h2>
                @if (productos.Any()) { var posicion = 0; foreach (var producto in productos) { posicion++; <div class="dashboard-row"><span class="dashboard-rank">@posicion</span><span class="dashboard-row-name">@producto.Nombre</span><strong>@producto.Cantidad unidades</strong></div> } }
                else { <p class="dashboard-label">No hay productos vendidos para los filtros seleccionados.</p> }
            </div>
            <div class="dashboard-panel"><h2><i class="bi bi-credit-card"></i>Ventas por método de pago</h2>
                @if (pagos.Any()) { foreach (var pago in pagos) { <div class="dashboard-row"><span class="dashboard-row-name">@pago.Nombre</span><strong>@pago.Cantidad</strong></div><div class="dashboard-bar"><span style="width:@(pedidos > 0 ? pago.Cantidad * 100 / pedidos : 0)%"></span></div> } }
                else { <p class="dashboard-label">No hay datos de pago para mostrar.</p> }
            </div>
        </div> }

        </div>
        <div class="row mb-3">
            <div class="col-md-12">
                <a asp-controller="Home" asp-action="PanelAdministrador" class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Volver al Panel
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Formulario de Filtros -->
        <div class="card mb-3" style="border-left: 4px solid #f1149b;">
            <div class="card-header" style="background-color: #f8cde7;">
                <h6 class="mb-0">
                    <i class="bi bi-funnel-fill me-2"></i>Filtros de Búsqueda
                </h6>
            </div>
            <div class="card-body">
                <form method="get" asp-action="Index" autocomplete="off" id="formFiltrosVenta" onsubmit="return validarFechasVenta()">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Fecha Inicio</label>
                            <input type="date" id="fechaInicio" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" min="2025-01-01" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Fecha Fin</label>
                            <input type="date" id="fechaFin" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" min="2025-01-01" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">Cliente</label>
                            <select name="clienteId" class="form-select">
                                <option value="">Todos los clientes</option>
                                @if (ViewBag.Clientes != null)
                                {
                                    @foreach (var cliente in ViewBag.Clientes)
                                    {
                                        <option value="@cliente.IdCliente" selected="@(ViewBag.ClienteId == cliente.IdCliente)">
                                            @cliente.Usuario.Nombres @cliente.Usuario.Apellidos
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-credit-card me-1"></i>Método de Pago
                            </label>
                            <select name="metodoPago" class="form-select">
                                <option value="">Todos los métodos</option>
                                <option value="Tarjeta" selected="@(ViewBag.MetodoPago == "Tarjeta")">
                                    <i class="bi bi-credit-card-2-front"></i> Tarjeta
                                </option>
                                <option value="Yape" selected="@(ViewBag.MetodoPago == "Yape")">
                                    <i class="bi bi-phone"></i> Yape
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="row mt-3">
                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search"></i> Buscar
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="bi bi-arrow-counterclockwise"></i> Limpiar Filtros
                            </a>
                            <button type="button" class="btn btn-success ms-auto" onclick="generarReporte()">
                                <i class="bi bi-file-earmark-bar-graph"></i> Generar Reporte
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div id="historialVentas">
        @if (Model != null && Model.Any())
        {
            <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                <div>
                    Se encontraron <strong>@Model.Count</strong> venta(s)
                    @if (ViewBag.MetodoPago != null)
                    {
                        <span>con método de pago: <strong>@ViewBag.MetodoPago</strong></span>
                    }
                    @if (ViewBag.FechaInicio != null || ViewBag.FechaFin != null)
                    {
                        <span>
                            | Período:
                            @if (ViewBag.FechaInicio != null)
                            {
                                <text>desde @DateTime.Parse(ViewBag.FechaInicio).ToString("dd/MM/yyyy")</text>
                            }
                            @if (ViewBag.FechaFin != null)
                            {
                                <text>hasta @DateTime.Parse(ViewBag.FechaFin).ToString("dd/MM/yyyy")</text>
                            }
                        </span>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Fecha Venta</th>
                                    <th>Cliente</th>
                                    <th>Subtotal</th>
                                    <th>Cupón</th>
                                    <th>Total</th>
                                    <th>Método Pago</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-bold">#@item.IdVenta</td>
                                        <td>@item.FechaVenta.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @item.ClienteNombre
                                            <br />
                                            <small class="text-muted">
                                                <i class="bi bi-bag"></i> @item.CantidadProductos producto(s)
                                            </small>
                                        </td>
                                        <td>S/ @item.SubtotalSinDescuento.ToString("F2")</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.CodigoCupon))
                                            {
                                                <span class="badge bg-success" title="Código: @item.CodigoCupon">
                                                    <i class="bi bi-tag-fill"></i> @item.PorcentajeDescuento%
                                                </span>
                                                <br />
                                                <small class="text-muted">@item.CodigoCupon</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="fw-bold text-success">S/ @item.TotalVenta.ToString("F2")</td>
                                        <td>
                                            @if (item.MetodoPago == "Efectivo")
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-cash"></i> @item.MetodoPago
                                                </span>
                                            }
                                            else if (item.MetodoPago == "Tarjeta")
                                            {
                                                <span class="badge bg-primary">
                                                    <i class="bi bi-credit-card"></i> @item.MetodoPago
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">
                                                    <i class="bi bi-bank"></i> @item.MetodoPago
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-sm btn-info" title="Ver detalles" data-bs-toggle="modal" data-bs-target="#modalDetalle@(item.IdVenta)">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <p class="text-muted">
                    <i class="bi bi-info-circle"></i> Total de ventas: <strong>@Model.Count</strong>
                </p>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="bi bi-info-circle" style="font-size: 2rem;"></i>
                <p class="mt-2 mb-0">No hay ventas registradas aún.</p>
                <small class="text-muted">Las ventas se generan automáticamente cuando los clientes realizan compras desde el catálogo.</small>
            </div>
        }
        </div>
    </div>
</div>

<div id="modalesVentas">
@if (ViewBag.VentasCompletas != null)
{
    @foreach (var venta in (List<Proyecto_DAS.Models.Venta>)ViewBag.VentasCompletas)
    {
        <!-- Modal Detalle -->
        <div class="modal fade" id="modalDetalle@(venta.IdVenta)" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header" style="background-color: #f1149b; color: white;">
                        <h5 class="modal-title">
                            <i class="bi bi-receipt"></i> Detalle de Venta #@venta.IdVenta
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p><strong>Cliente:</strong> @venta.Cliente.Usuario.Nombres @venta.Cliente.Usuario.Apellidos</p>
                                <p><strong>DNI/RUC:</strong> @venta.Cliente.DniRuc</p>
                                <p><strong>Fecha:</strong> @venta.FechaVenta.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Método de Pago:</strong> @venta.MetodoPago</p>
                                @if (venta.CuponDescuentoId != null && venta.CuponDescuento != null)
                                {
                                    <p><strong>Cupón:</strong> @venta.CuponDescuento.CodigoCupon (@venta.CuponDescuento.PorcentajeDescuento%)</p>
                                }
                            </div>
                        </div>

                        @if (venta.DetallesVenta != null && venta.DetallesVenta.Any())
                        {
                            <h6 class="mb-3">Productos:</h6>
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Producto</th>
                                        <th>Precio Unit.</th>
                                        <th>Cantidad</th>
                                        <th>Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in venta.DetallesVenta)
                                    {
                                        <tr>
                                            <td>@detalle.Producto?.Nombre</td>
                                            <td>S/ @detalle.PrecioUnitario.ToString("F2")</td>
                                            <td>@detalle.Cantidad</td>
                                            <td>S/ @((detalle.PrecioUnitario * detalle.Cantidad).ToString("F2"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        <div class="card mt-3" style="background-color: #f8cde7;">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-6 text-end"><strong>Subtotal:</strong></div>
                                    <div class="col-6">S/ @venta.SubtotalSinDescuento.ToString("F2")</div>
                                </div>
                                @if (venta.CuponDescuentoId != null && venta.CuponDescuento != null)
                                {
                                    var descuento = venta.SubtotalSinDescuento - venta.TotalVenta;
                                    <div class="row text-success">
                                        <div class="col-6 text-end"><strong>Descuento (@venta.CuponDescuento.PorcentajeDescuento%):</strong></div>
                                        <div class="col-6">- S/ @descuento.ToString("F2")</div>
                                    </div>
                                }
                                <hr />
                                <div class="row">
                                    <div class="col-6 text-end"><h5><strong>Total:</strong></h5></div>
                                    <div class="col-6"><h5 class="text-success"><strong>S/ @venta.TotalVenta.ToString("F2")</strong></h5></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="@Url.Action("DescargarBoleta", "Venta", new { id = venta.IdVenta })" class="btn btn-success" target="_blank">
                            <i class="bi bi-file-earmark-pdf"></i> Descargar Boleta
                        </a>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle"></i> Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/js/dashboard-ventas.js" asp-append-version="true" defer></script>
    <script>
        const seriesVentas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(series));
        const datosCategorias = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(categorias));
        const datosProductos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productos));
        const datosPagos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(pagos));
        const coloresDashboard = ['#f1149b', '#ff78b9', '#bd4c9a', '#ffb2d4', '#8a4c93', '#f68ca5'];
        if (typeof Chart !== 'undefined') {
            Chart.defaults.font.family = 'Montserrat, sans-serif';
            Chart.defaults.color = '#8791a1';
            const opciones = { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { grid: { display: false } }, y: { beginAtZero: true, grid: { color: '#f4edf2' } } } };
            const graficoVentas = new Chart(document.getElementById('graficoVentas'), { type: 'line', data: { labels: [], datasets: [{ label: 'Ventas (S/)', data: [], borderColor: '#f1149b', backgroundColor: 'rgba(241,20,155,.12)', fill: true, tension: .35, pointBackgroundColor: '#f1149b' }] }, options: opciones });
            function actualizarGrafico() {
                const periodo = document.getElementById('periodoGrafico').value;
                let datos = seriesVentas;
                if (periodo !== 'all') {
                    const fin = new Date(); fin.setHours(0,0,0,0);
                    datos = Array.from({length: Number(periodo)}, (_, i) => { const fecha = new Date(fin); fecha.setDate(fecha.getDate() - Number(periodo) + 1 + i); const clave = fecha.getFullYear() + '-' + String(fecha.getMonth()+1).padStart(2,'0') + '-' + String(fecha.getDate()).padStart(2,'0'); return seriesVentas.find(x => x.Fecha === clave) || {Fecha: clave, Total: 0}; });
                }
                graficoVentas.data.labels = datos.map(x => x.Fecha); graficoVentas.data.datasets[0].data = datos.map(x => x.Total); graficoVentas.update();
            }
            document.getElementById('periodoGrafico').addEventListener('change', actualizarGrafico); actualizarGrafico();
            new Chart(document.getElementById('graficoCategorias'), { type: 'doughnut', data: { labels: datosCategorias.map(x => x.Nombre), datasets: [{ data: datosCategorias.map(x => x.Cantidad), backgroundColor: coloresDashboard, borderWidth: 3 }] }, options: { responsive: true, maintainAspectRatio: false, cutout: '68%', plugins: { legend: { position: 'bottom', labels: { boxWidth: 10 } } } } });
            new Chart(document.getElementById('graficoProductos'), { type: 'bar', data: { labels: datosProductos.map(x => x.Nombre), datasets: [{ label: 'Unidades', data: datosProductos.map(x => x.Cantidad), backgroundColor: '#f477b8', borderRadius: 6 }] }, options: { ...opciones, indexAxis: 'y' } });
            new Chart(document.getElementById('graficoPagos'), { type: 'bar', data: { labels: datosPagos.map(x => x.Nombre), datasets: [{ label: 'Pedidos', data: datosPagos.map(x => x.Cantidad), backgroundColor: coloresDashboard, borderRadius: 6 }] }, options: opciones });
        } else { document.querySelectorAll('.chart-wrap').forEach(el => el.innerHTML = '<div class="chart-empty">No se pudieron cargar los gráficos. Comprueba tu conexión a internet.</div>'); }
        function validarFechasVenta() {
            var fechaInicio = document.getElementById('fechaInicio').value;
            var fechaFin = document.getElementById('fechaFin').value;

            if (fechaInicio && fechaFin) {
                if (new Date(fechaInicio) > new Date(fechaFin)) {
                    alert('La fecha de inicio no puede ser mayor a la fecha de fin.');
                    return false;
                }
            }
            return true;
        }

        function generarReporte() {
            if (!validarFechasVenta()) {
                return;
            }

            // Obtener los valores de los filtros actuales
            var fechaInicio = document.getElementById('fechaInicio').value;
            var fechaFin = document.getElementById('fechaFin').value;
            var clienteId = document.querySelector('select[name="clienteId"]').value;
            var metodoPago = document.querySelector('select[name="metodoPago"]').value;

            // Construir URL con parámetros
            var url = '@Url.Action("GenerarReporteExcel", "Venta")';
            var params = [];

            if (fechaInicio) params.push('fechaInicio=' + fechaInicio);
            if (fechaFin) params.push('fechaFin=' + fechaFin);
            if (clienteId) params.push('clienteId=' + clienteId);
            if (metodoPago) params.push('metodoPago=' + encodeURIComponent(metodoPago));

            if (params.length > 0) {
                url += '?' + params.join('&');
            }

            // Redirigir para descargar el archivo
            window.location.href = url;
        }
    </script>
}

